# Copy to .env and edit. .env is git-ignored; never commit it. See docs/configuration.md.
# The file is sourced by bash, so quote values with spaces.

# --- Paths ---------------------------------------------------------------
# EXAONE-4.5-33B-FP8 checkpoint downloaded with `hf download ... --local-dir` (required).
MODEL_DIR=/path/to/EXAONE-4.5-33B-FP8
# Everything this repo writes: raw data, generated data, checkpoints, serving dirs, logs, benchmarks.
# Put it on the same filesystem as MODEL_DIR so serving dirs can hard-link the unchanged shards.
WORK_DIR=./work
# CACHE_DIR=./work/cache

# --- Credentials (pick one way per key; leave the others empty) ---------
# AI Hub 271 (Korean dialogue). Apply for the dataset on aihub.or.kr first.
AIHUB_API_KEY=
# AIHUB_API_KEY_FILE=~/.config/aihub/key        # file holding only the key (chmod 600)
# AIHUB_API_KEY_CMD='op read "op://Vault/AI Hub/API-KEY"'   # command that prints the key
# Optional: Hugging Face token (higher rate limits). All datasets and the model are public.
HF_TOKEN=

# --- GPU and server connection --------------------------------------------
# Value for `docker run --gpus`: all, device=0, or device=0,1
GPU_DEVICES=all
VLLM_IMAGE=vllm/vllm-openai:v0.31.0
# local: scripts start/stop vLLM on this host. external: use a server you run yourself at VLLM_BASE_URL.
SERVER_MODE=local
VLLM_PORT=18001
# Base URL without /v1. For a remote GPU host: http://gpu-host:18001 (or an SSH tunnel to it).
VLLM_BASE_URL=http://localhost:18001
# Bearer token. With SERVER_MODE=local the server is started with it; with external it must match the server.
VLLM_API_KEY=
SERVED_MODEL_NAME=exaone45-33b-fp8
# 1 = refuse to run training and a vLLM server at the same time (required on GB10 / unified memory).
EXCLUSIVE_GPU=1

# --- Benchmark server (serve.sh up nospec|mtp) ----------------------------
GPU_MEM_UTIL=0.80
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=8
CUDAGRAPH_MAX_SIZE=32
NUM_SPEC_TOKENS=3
# VLLM_EXTRA_ARGS="--enforce-eager"

# --- Generation server (serve.sh up gen) ----------------------------------
GEN_GPU_MEM_UTIL=0.80
GEN_MAX_MODEL_LEN=8192
GEN_MAX_NUM_SEQS=128
GEN_CONCURRENCY=96

# --- Training -------------------------------------------------------------
# torch.cuda.set_per_process_memory_fraction; leave empty for the default 0.55 (GB10). 0.9 on a discrete GPU.
TRAIN_MEM_FRAC=
# docker --memory for the training container, e.g. 96g on GB10. Empty = no limit.
TRAIN_MEM_LIMIT=
# Kill training when host MemAvailable drops below this many GiB (GB10: 16). 0 = off.
TRAIN_MIN_FREE_GB=0
